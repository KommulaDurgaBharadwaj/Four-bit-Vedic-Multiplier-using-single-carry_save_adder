module carry_sav_adder(
    input  [3:0] a,
    input  [3:0] b,
    input  [3:0] c,
    output [3:0] out,
    output [1:0] cout 
);

    wire [3:0] carry;
    wire [3:0] s;
    wire [5:0] temp;  
    FA u1(a[0], b[0], c[0], s[0], carry[0]);
    FA u2(a[1], b[1], c[1], s[1], carry[1]);
    FA u3(a[2], b[2], c[2], s[2], carry[2]);
    FA u4(a[3], b[3], c[3], s[3], carry[3]);

    
    assign temp = {2'b00, s} + {1'b0, carry, 1'b0};


    assign out  = temp[3:0];
    assign cout = temp[5:4];

endmodule
